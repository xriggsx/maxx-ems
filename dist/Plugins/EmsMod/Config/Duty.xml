<?xml version="1.0" encoding="utf-8"?>
<DutyConfig>
  <!-- Paramedic on-duty start / respawn points. One is picked at RANDOM each
       time you go on duty. -->
  <Hospitals>
    <Hospital><Name>Pillbox Hill Medical Center</Name><X>298.6</X><Y>-584.9</Y><Z>43.3</Z><Heading>70</Heading></Hospital>
    <Hospital><Name>Central Los Santos Medical Center</Name><X>340.6</X><Y>-1396.6</Y><Z>32.5</Z><Heading>240</Heading></Hospital>
    <Hospital><Name>Mount Zonah Medical Center</Name><X>-449.7</X><Y>-340.3</Y><Z>34.5</Z><Heading>250</Heading></Hospital>
    <Hospital><Name>Sandy Shores Medical Center</Name><X>1839.6</X><Y>3672.9</Y><Z>34.3</Z><Heading>210</Heading></Hospital>
    <Hospital><Name>Paleto Bay Care Center</Name><X>-247.8</X><Y>6330.3</Y><Z>32.4</Z><Heading>220</Heading></Hospital>
  </Hospitals>

  <!-- Firefighter on-duty start / respawn points. One is picked at RANDOM each
       time you go on duty as a firefighter. -->
  <FireStations>
    <FireStation><Name>Davis Fire Station</Name><X>198.5</X><Y>-1642.5</Y><Z>29.8</Z><Heading>320</Heading></FireStation>
    <FireStation><Name>El Burro Heights Fire Station</Name><X>1191.7</X><Y>-1467.3</Y><Z>34.9</Z><Heading>90</Heading></FireStation>
    <FireStation><Name>Rockford Hills Fire Station</Name><X>-671.0</X><Y>-1103.6</Y><Z>22.3</Z><Heading>50</Heading></FireStation>
    <FireStation><Name>Sandy Shores Fire Station</Name><X>1697.5</X><Y>3584.0</Y><Z>35.4</Z><Heading>210</Heading></FireStation>
    <FireStation><Name>Paleto Bay Fire Station</Name><X>-379.5</X><Y>6120.5</Y><Z>31.5</Z><Heading>45</Heading></FireStation>
  </FireStations>

  <!-- Per-mode curated picks. Add your add-on uniform peds / vehicles here
       (model names) once installed via OpenIV - no rebuild needed. -->
  <Modes>
    <DutyMode>
      <Name>Paramedic</Name>
      <Characters>
        <string>s_m_m_paramedic_01</string>
        <string>s_f_y_scrubs_01</string>
        <string>s_m_m_doctor_01</string>
      </Characters>
      <!-- Each vehicle = a Model + optional Livery (-1 = default) + display Name.
           Add the same model with different Livery numbers for state variants,
           or add-on model names for different vehicles - no replacing. -->
      <Vehicles>
        <DutyVehicle><Model>ambulance</Model><Livery>-1</Livery><Name>Ambulance (NSW)</Name></DutyVehicle>
        <!-- Add-on ambulances re-add here once the dlcpacks load without crashing:
        <DutyVehicle><Model>f750</Model><Livery>0</Livery><Name>F750 Ambulance</Name></DutyVehicle>
        <DutyVehicle><Model>exp</Model><Livery>0</Livery><Name>EMS SUV</Name></DutyVehicle>
        -->
      </Vehicles>
      <Equipment>
        <string>weapon_flashlight</string>
      </Equipment>
    </DutyMode>
    <DutyMode>
      <Name>Firefighter</Name>
      <StartLocationType>FireStation</StartLocationType>
      <Characters>
        <string>s_m_y_fireman_01</string>
      </Characters>
      <Vehicles>
        <DutyVehicle><Model>firetruk</Model><Livery>-1</Livery><Name>Fire Truck (NSW)</Name></DutyVehicle>
        <!-- Add-on fire trucks re-add here once the dlcpacks load without crashing:
        <DutyVehicle><Model>ferrara</Model><Livery>-1</Livery><Name>Ferrara Fire Truck</Name></DutyVehicle>
        -->
      </Vehicles>
      <Equipment>
        <string>weapon_fireextinguisher</string>
        <string>weapon_flashlight</string>
      </Equipment>
    </DutyMode>
  </Modes>

  <!-- AI partner rides along whenever you're on duty. Set false to go solo. -->
  <EnablePartner>true</EnablePartner>
</DutyConfig>
